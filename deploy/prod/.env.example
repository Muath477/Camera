# Copy to .env and fill in. Generate secrets with: openssl rand -base64 32

APP_DOMAIN=app.example.sa
API_DOMAIN=api.example.sa
MEDIA_DOMAIN=media.example.sa
MQTT_DOMAIN=mqtt.example.sa
# Devices call this with their client certificate; its server certificate comes from the private CA.
DEVICE_API_DOMAIN=device.example.sa
ACME_EMAIL=ops@example.sa
CAMERA_VERSION=latest

POSTGRES_PASSWORD=
CAMERA_API_PASSWORD=
MQTT_PASSWORD=
S3_ACCESS_KEY=camera
S3_SECRET_KEY=
MEDIA_RETENTION_DAYS=90
BACKUP_KEEP_DAYS=30

# Sessions and links
JWT_SECRET=
LINK_SECRET=
ENROLL_SECRET=
# 32 random bytes, base64 (openssl rand -base64 32)
SNAPSHOT_SIGNING_SEED=

# Push notifications: generate once with `go run ./cmd/api vapid` and keep.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Sign-in codes and alerts by SMS: http posts {"to","from","text"} to SMS_HTTP_URL.
SMS_PROVIDER=http
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_FROM=Camera

# WhatsApp Business Cloud API (optional). WHATSAPP_TEMPLATE is an approved
# template with one body parameter.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=

# Optional: an external identity provider in addition to phone sign-in.
OIDC_JWKS_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=

# Optional: text embedding service for search by description.
EMBEDDER_URL=
